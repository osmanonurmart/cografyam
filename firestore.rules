rules_version = '2';

// Coğrafyam — Firestore güvenlik kuralları
//
// Giriş yok: uygulamayı açan herkes aynı veriyi görür ve düzenleyebilir
// (Kart Kutusu ile aynı mantık). Bu bilinçli bir tercih — kişisel bir
// çalışma aracı, hesap yönetmenin maliyeti kazancından fazla.
//
// Kimlik doğrulaması olmadığı için kuralların yapabileceği tek şey
// BİÇİM denetimi: bozuk, devasa ya da alakasız kayıt yazılamasın.
// Adres bilinirse içerik değiştirilebilir; korunma adresin bilinmemesi
// ve API anahtarının alan adıyla sınırlanmasıdır.
//
// Yayına almak için:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function makul(deger, enFazla) {
      return !(deger is string) || deger.size() <= enFazla;
    }

    // DİKKAT: `allow write` create + update + DELETE demektir. Silmede
    // yazılan bir belge olmadığı için `request.resource` null olur;
    // içine alan denetimi koyulursa kural değerlendirilemez ve SİLME
    // SESSİZCE REDDEDİLİR. Bu yüzden delete ayrı tutuluyor.

    match /konular/{konuId} {
      allow read: if true;
      allow create, update: if makul(request.resource.data.ad, 200);
      allow delete: if true;
    }

    match /ustKonular/{ustId} {
      allow read: if true;
      allow create, update: if makul(request.resource.data.ad, 200);
      allow delete: if true;
    }

    // Palet görselleri: `veri` bir data: URL — 128x128 PNG ~10-40 KB.
    // Firestore belge sınırı 1 MB; 700 KB üstünü baştan reddediyoruz.
    match /gorseller/{gorselId} {
      allow read: if true;
      allow create, update: if makul(request.resource.data.ad, 200)
                            && makul(request.resource.data.veri, 700000);
      allow delete: if true;
    }

    // Tek belgede duran kayıtlar: ayarlar/genel, ilerleme/genel, gunluk/genel
    match /ayarlar/{belge}  { allow read, write: if true; }
    match /ilerleme/{belge} { allow read, write: if true; }
    match /gunluk/{belge}   { allow read, write: if true; }

    // Yukarıda eşleşmeyen her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
